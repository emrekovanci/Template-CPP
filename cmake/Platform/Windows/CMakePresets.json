{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 26,
        "patch": 0
    },
    "include": [
        "../Common/CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "windows-vs2026",
            "description": "Configure Windows to use the VS2026 generator",
            "binaryDir": "${sourceDir}/build/windows-vs2026-msvc",
            "inherits": [
                "host-windows",
                "cpp-standard",
                "vs2026",
                "msvc",
                "vcpkg"
            ],
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "set"
            }
        },
        {
            "name": "windows-vs2026-clangcl",
            "description": "Configure Windows to use the VS2026 generator and the ClangCL compiler",
            "binaryDir": "${sourceDir}/build/windows-vs2026-clangcl",
            "inherits": [
                "host-windows",
                "cpp-standard",
                "vs2026",
                "clang-cl",
                "vcpkg"
            ],
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "ClangCL,host=x64",
                "strategy": "set"
            }
        },
        {
            "name": "windows-ninja",
            "description": "Configure Windows using the Ninja generator",
            "binaryDir": "${sourceDir}/build/windows-ninja-msvc",
            "inherits": [
                "host-windows",
                "cpp-standard",
                "ninja",
                "msvc",
                "vcpkg"
            ],
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "windows-ninja-clangcl",
            "description": "Configure Windows using the Ninja generator and the ClangCL compiler",
            "binaryDir": "${sourceDir}/build/windows-ninja-clangcl",
            "inherits": [
                "host-windows",
                "cpp-standard",
                "ninja",
                "clang-cl",
                "vcpkg"
            ],
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "ClangCL,host=x64",
                "strategy": "external"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-vs2026",
            "configurePreset": "windows-vs2026",
            "inherits": [
                "host-windows"
            ]
        },
        {
            "name": "windows-vs2026-clangcl",
            "configurePreset": "windows-vs2026-clangcl",
            "inherits": [
                "host-windows"
            ]
        },
        {
            "name": "windows-ninja",
            "configurePreset": "windows-ninja",
            "inherits": [
                "host-windows"
            ]
        },
        {
            "name": "windows-ninja-clangcl",
            "configurePreset": "windows-ninja-clangcl",
            "inherits": [
                "host-windows"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "windows-vs2026",
            "configurePreset": "windows-vs2026",
            "inherits": [
                "test-default",
                "host-windows"
            ]
        },
        {
            "name": "windows-vs2026-clangcl",
            "configurePreset": "windows-vs2026-clangcl",
            "inherits": [
                "test-default",
                "host-windows"
            ]
        },
        {
            "name": "windows-ninja",
            "configurePreset": "windows-ninja",
            "inherits": [
                "test-default",
                "host-windows"
            ]
        },
        {
            "name": "windows-ninja-clangcl",
            "configurePreset": "windows-ninja-clangcl",
            "inherits": [
                "test-default",
                "host-windows"
            ]
        }
    ]
}
